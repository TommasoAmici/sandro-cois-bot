{
  "name": "sandro-cois-bot",
  "scripts": {
    "start": "bun run src/index.ts",
    "start:watch": "bun --hot src/index.ts",
    "test": "bun test --watch",
    "test:ci": "bun test",
    "format": "bun fmt",
    "lint": "biome check --write .",
    "lint:unsafe": "biome check --write --unsafe .",
    "lint:check": "biome ci ."
  },
  "dependencies": {
    "@grammyjs/runner": "2.0.3",
    "@grammyjs/transformer-throttler": "1.2.1",
    "chrono-node": "^2.10.3",
    "diacritics": "1.3.0",
    "grammy": "1.46.0",
    "html-entities": "2.6.0",
    "mathjs": "15.2.0",
    "node-html-parser": "9.0.5",
    "pokedex": "1.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/bun": "1.4.4",
    "@types/diacritics": "1.3.3"
  }
}
