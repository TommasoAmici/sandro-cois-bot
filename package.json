    "googlethis": "1.8.0",
    "grammy": "1.45.1",
    "html-entities": "2.6.0",
    "mathjs": "15.2.0",
    "node-html-parser": "9.0.0",
    "pokedex": "1.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/bun": "1.3.14",
